# Unusual Whales API key
# Server-side only. Never expose this to the browser.
# Get a key at https://unusualwhales.com
UNUSUAL_WHALES_API_KEY=

# Lock-screen alerts (optional — skip a channel if its pair is empty)
# Pushover: create an app at https://pushover.net/apps/build for PUSHOVER_APP_TOKEN
# User key is on https://pushover.net  (your device is already linked)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Telegram is OFF by default; set TELEGRAM_ENABLED=1 to send.
TELEGRAM_ENABLED=
# Telegram: message @BotFather for TELEGRAM_BOT_TOKEN, then message your bot
# and get TELEGRAM_CHAT_ID from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret for POST /api/notify (header x-flowguard-key or ?key=)
NOTIFY_SECRET=
# Optional shadow-module knobs: SHADOW_LLM_DAILY_USD=1 SHADOW_SEARCH_MODEL=grok-4.3 SHADOW_MAX_LLM_RUNS=6

# Persistence (lib/kv). Preferred: Upstash Redis via Vercel Marketplace (free tier) — sets these automatically:
# KV_REST_API_URL= / KV_REST_API_TOKEN=   (or UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=)
# Without Redis, Blob is used in "lite" mode (no list/head; rare writes only). Guards:
# BLOB_WRITES_PER_DAY=25  BLOB_READS_PER_DAY=300  REDIS_CMDS_PER_INSTANCE_DAY=8000
# LLM calls are refused without a durable store unless LLM_ALLOW_WITHOUT_STORE=1 (then LLM_INSTANCE_CAP_USD=0.25 per instance).

# TEST MODE: Tastytrade quote comparison log (off by default). Read-only OAuth app (read + openid); logs Tastytrade
# bid/ask next to the UW quote for open paper positions + spread-check candidates via /api/shadow/tick. No orders, ever.
# FLOWGUARD_TASTY_TEST=1
# TASTYTRADE_REFRESH_TOKEN=          (long-lived grant refresh token; env only, never a file)
# TASTYTRADE_CLIENT_SECRET=
# TASTYTRADE_CLIENT_ID=              (optional; must match the grant if set)
# TASTYTRADE_API_BASE=https://api.tastyworks.com   (production; the cert sandbox serves no market data)

# TEST MODE: Grok wide pool (off by default; also needs FLOWGUARD_LESSONS_TEST=1). Grok + lessons take/pass on session-tape
# setups the live lists cut (pool rank below the caps + score 45-54 near-misses), own doc (kind grok-wide), own $ ledger.
# Rides /api/shadow/tick; 0 flow calls; grading = 1 UW historic per candidate after its 2-session time stop. Never live.
# FLOWGUARD_GROK_WIDE=1
# FLOWGUARD_GROK_WIDE_MAX=200        (candidates/day, hard max 400; ~10 Grok batches of 20 at ~$0.028 each)
# FLOWGUARD_GROK_WIDE_USD=1          (own daily Grok cap, hard max 3; does not use SHADOW_LLM_DAILY_USD)
