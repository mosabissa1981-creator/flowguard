# Unusual Whales API key
# Server-side only. Never expose this to the browser.
# Get a key at https://unusualwhales.com
UNUSUAL_WHALES_API_KEY=

# Lock-screen alerts (optional — skip a channel if its pair is empty)
# Pushover: create an app at https://pushover.net/apps/build for PUSHOVER_APP_TOKEN
# User key is on https://pushover.net  (your device is already linked)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Telegram: message @BotFather for TELEGRAM_BOT_TOKEN, then message your bot
# and get TELEGRAM_CHAT_ID from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret for POST /api/notify (header x-flowguard-key or ?key=)
NOTIFY_SECRET=
# Optional shadow-module knobs: SHADOW_LLM_DAILY_USD=1 SHADOW_SEARCH_MODEL=grok-4.3 SHADOW_MAX_LLM_RUNS=6

# Persistence (lib/kv). Preferred: Upstash Redis via Vercel Marketplace (free tier) — sets these automatically:
# KV_REST_API_URL= / KV_REST_API_TOKEN=   (or UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=)
# Without Redis, Blob is used in "lite" mode (no list/head; rare writes only). Guards:
# BLOB_WRITES_PER_DAY=25  BLOB_READS_PER_DAY=300  REDIS_CMDS_PER_INSTANCE_DAY=8000
# LLM calls are refused without a durable store unless LLM_ALLOW_WITHOUT_STORE=1 (then LLM_INSTANCE_CAP_USD=0.25 per instance).
