# Unusual Whales API key
# Server-side only. Never expose this to the browser.
# Get a key at https://unusualwhales.com
UNUSUAL_WHALES_API_KEY=

# Lock-screen alerts (optional — skip a channel if its pair is empty)
# Pushover: create an app at https://pushover.net/apps/build for PUSHOVER_APP_TOKEN
# User key is on https://pushover.net  (your device is already linked)
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
# Telegram: message @BotFather for TELEGRAM_BOT_TOKEN, then message your bot
# and get TELEGRAM_CHAT_ID from https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
